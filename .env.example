# Copy this file to .env for local development.
# Generate a secure token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TEST_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
PORT=8080
SERVICE_NAME=secure-device-test-server
MAX_EVENTS_PER_MINUTE=60
MAX_CONNECTIONS_PER_IP=10
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
